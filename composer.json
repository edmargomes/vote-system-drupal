{
    "name": "edmargomes/vote-system-drupal",
    "description": "Drupal 11 voting system — custom module with entities, manual REST API and token-based authentication.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.0",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-recommended": "^11",
        "drush/drush": "^13"
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "drupal/core-dev": "^11",
        "mglaman/phpstan-drupal": "^1.0",
        "phpro/grumphp": "^2.0",
        "phpstan/phpstan": "^1.0",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": true,
            "phpro/grumphp": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/sites/default/settings.php": false
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "drush/Migrations/contrib/{$name}": ["type:drupal-migration"]
        },
        "grumphp": {
            "config-default-path": "grumphp.yml"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
