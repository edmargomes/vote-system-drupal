{
  "info": {
    "name": "Voting System API",
    "description": "Manual testing collection for the vs_core Drupal 11 voting module.\n\nAll endpoints require HTTP Basic authentication. There is no token endpoint — credentials are sent on every request in the Authorization header.\n\n## Setup instructions\n\n1. Create or identify a Drupal user with the `vote` permission at `/admin/people`.\n2. Encode the credentials: run `echo -n \"username:password\" | base64` in a terminal.\n3. Open this collection in Postman, go to the Variables tab, and paste the Base64 string into `user_credentials`.\n4. Repeat steps 1-3 for an admin user with `administer voting` permission and paste the result into `admin_credentials`.\n5. Copy a real question UUID from `/admin/content/voting-questions` and paste it into `question_uuid`.\n6. Copy an option UUID that belongs to the question above and paste it into `option_uuid`.\n7. Copy an option UUID that belongs to a **different** question and paste it into `other_question_option_uuid`.\n\n**Do not create a Drupal user with username `wrong` and password `credentials`** — the \"Wrong password\" error case uses that hardcoded pair to guarantee a 401.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://voting-system.lndo.site",
      "type": "string"
    },
    {
      "key": "question_uuid",
      "value": "REPLACE-WITH-REAL-UUID",
      "type": "string"
    },
    {
      "key": "option_uuid",
      "value": "REPLACE-WITH-REAL-UUID",
      "type": "string"
    },
    {
      "key": "other_question_option_uuid",
      "value": "REPLACE-WITH-REAL-UUID",
      "type": "string"
    },
    {
      "key": "user_credentials",
      "value": "YOUR_BASE64_CREDENTIALS",
      "type": "string",
      "description": "Base64 of username:password for a Drupal user with the vote permission. Run: echo -n 'user:pass' | base64"
    },
    {
      "key": "admin_credentials",
      "value": "YOUR_BASE64_ADMIN_CREDENTIALS",
      "type": "string",
      "description": "Base64 of username:password for a Drupal user with administer voting permission. Run: echo -n 'admin:pass' | base64"
    }
  ],
  "item": [
    {
      "name": "Questions",
      "item": [
        {
          "name": "List questions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{user_credentials}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/questions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "questions"]
            },
            "description": "Returns all active voting questions. Requires Basic auth with the `vote` permission. Response shape: `{ data: [...], meta: { total: N } }`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response has data array\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"data\").that.is.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Response has meta.total\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.nested.property(\"meta.total\").that.is.a(\"number\");",
                  "});",
                  "",
                  "pm.test(\"No integer id in question items\", function () {",
                  "    const body = pm.response.json();",
                  "    if (body.data.length > 0) {",
                  "        pm.expect(body.data[0]).to.not.have.property(\"id\");",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get question detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{user_credentials}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/questions/{{question_uuid}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "questions", "{{question_uuid}}"]
            },
            "description": "Returns full detail for one question including its options. Each option has `uuid`, `title`, `description`, and `image_url` (nullable). Never exposes integer IDs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response has data.uuid\", function () {",
                  "    pm.expect(pm.response.json()).to.have.nested.property(\"data.uuid\");",
                  "});",
                  "",
                  "pm.test(\"Response has data.title\", function () {",
                  "    pm.expect(pm.response.json()).to.have.nested.property(\"data.title\");",
                  "});",
                  "",
                  "pm.test(\"Response has data.options array\", function () {",
                  "    pm.expect(pm.response.json()).to.have.nested.property(\"data.options\").that.is.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Options have uuid and title, not id\", function () {",
                  "    const options = pm.response.json().data.options;",
                  "    if (options.length > 0) {",
                  "        pm.expect(options[0]).to.have.property(\"uuid\");",
                  "        pm.expect(options[0]).to.have.property(\"title\");",
                  "        pm.expect(options[0]).to.not.have.property(\"id\");",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Voting",
      "item": [
        {
          "name": "Cast vote (show_results false)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{user_credentials}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"option_uuid\": \"{{option_uuid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/questions/{{question_uuid}}/vote",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "questions", "{{question_uuid}}", "vote"]
            },
            "description": "Registers a vote. When the question's `show_results` flag is false the response contains only `status` and `message`. The user identity is always resolved server-side from the auth token — never send a user ID in the body.\n\nTo use this request, ensure the target question has `show_results` set to **false** in the Drupal admin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response has status: success\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"status\", \"success\");",
                  "});",
                  "",
                  "pm.test(\"Response has message\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"message\");",
                  "});",
                  "",
                  "pm.test(\"Results key is absent when show_results is false\", function () {",
                  "    pm.expect(pm.response.json()).to.not.have.property(\"results\");",
                  "});",
                  "",
                  "pm.test(\"Cache-Control is no-store\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cast vote (show_results true)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{user_credentials}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"option_uuid\": \"{{option_uuid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/questions/{{question_uuid}}/vote",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "questions", "{{question_uuid}}", "vote"]
            },
            "description": "Registers a vote on a question where `show_results` is enabled. The response includes a `results` array with per-option `option_uuid`, `title`, `votes`, and `percentage`. To test this request, the target question must have `show_results` set to **true** in the Drupal admin at `/admin/content/voting-questions`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response has status: success\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"status\", \"success\");",
                  "});",
                  "",
                  "pm.test(\"Results key is present when show_results is true\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"results\").that.is.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Each result row has required fields\", function () {",
                  "    const results = pm.response.json().results;",
                  "    if (results.length > 0) {",
                  "        pm.expect(results[0]).to.have.property(\"option_uuid\");",
                  "        pm.expect(results[0]).to.have.property(\"title\");",
                  "        pm.expect(results[0]).to.have.property(\"votes\");",
                  "        pm.expect(results[0]).to.have.property(\"percentage\");",
                  "        pm.expect(results[0]).to.not.have.property(\"option_id\");",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get results (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{admin_credentials}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/questions/{{question_uuid}}/results",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "questions", "{{question_uuid}}", "results"]
            },
            "description": "Returns vote tallies for every option on the question. Requires `administer voting` permission (admin user). Returns results regardless of the question's `show_results` flag. Result rows contain `option_uuid`, `title`, `votes`, and `percentage` — never `option_id`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response has question object\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"question\");",
                  "});",
                  "",
                  "pm.test(\"Question has uuid, title, show_results, total_votes\", function () {",
                  "    const q = pm.response.json().question;",
                  "    pm.expect(q).to.have.property(\"uuid\");",
                  "    pm.expect(q).to.have.property(\"title\");",
                  "    pm.expect(q).to.have.property(\"show_results\");",
                  "    pm.expect(q).to.have.property(\"total_votes\");",
                  "});",
                  "",
                  "pm.test(\"Response has results array\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"results\").that.is.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Result rows have option_uuid not option_id\", function () {",
                  "    const results = pm.response.json().results;",
                  "    if (results.length > 0) {",
                  "        pm.expect(results[0]).to.have.property(\"option_uuid\");",
                  "        pm.expect(results[0]).to.not.have.property(\"option_id\");",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Duplicate vote (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{user_credentials}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"option_uuid\": \"{{option_uuid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/questions/{{question_uuid}}/vote",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "questions", "{{question_uuid}}", "vote"]
            },
            "description": "Sending a second vote for the same question with the same user returns 409 Conflict. Run \"Cast vote (show_results false)\" first with the same credentials and question UUID to guarantee a prior vote exists."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"Error is duplicate_vote\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"error\", \"duplicate_vote\");",
                  "});",
                  "",
                  "pm.test(\"Response has message\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"message\");",
                  "});",
                  "",
                  "pm.test(\"Cache-Control is no-store\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "No credentials (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/questions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "questions"]
            },
            "description": "A request to any authenticated endpoint without an Authorization header must return 401. This request intentionally omits the Authorization header."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong password (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic d3Jvbmc6Y3JlZGVudGlhbHM=",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/questions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "questions"]
            },
            "description": "Basic auth with an invalid username/password pair (`wrong:credentials` encoded as Base64). Must return 401.\n\nThe header value `d3Jvbmc6Y3JlZGVudGlhbHM=` is the Base64 encoding of `wrong:credentials`. Do not create a Drupal user with that username/password combination, as it would cause this test to succeed with a 200 instead of a 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Voting disabled (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{user_credentials}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"option_uuid\": \"{{option_uuid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/questions/{{question_uuid}}/vote",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "questions", "{{question_uuid}}", "vote"]
            },
            "description": "When voting is disabled in the admin settings (`/admin/config/content/vs-core`), all write endpoints return 403 with `error: \"voting_disabled\"`. Disable voting before running this request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test(\"Error is voting_disabled\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"error\", \"voting_disabled\");",
                  "});"
                ]
              }
            }
          ]
        },
