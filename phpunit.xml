<?xml version="1.0" encoding="UTF-8"?>
<phpunit
  bootstrap="web/core/tests/bootstrap.php"
  colors="true"
  beStrictAboutTestsThatDoNotTestAnything="true">

  <testsuites>
    <testsuite name="Unit">
      <directory>web/modules/custom/voting_system/tests/src/Unit</directory>
    </testsuite>
    <testsuite name="Kernel">
      <directory>web/modules/custom/voting_system/tests/src/Kernel</directory>
    </testsuite>
    <testsuite name="Contract">
      <directory>web/modules/custom/voting_system/tests/src/Functional/Api/Contract</directory>
    </testsuite>
    <testsuite name="Integration">
      <directory>web/modules/custom/voting_system/tests/src/Functional/Api/Integration</directory>
    </testsuite>
  </testsuites>

  <!-- Source files included in coverage calculation -->
  <coverage>
    <include>
      <directory suffix=".php">
        web/modules/custom/voting_system/src
      </directory>
    </include>

    <report>
      <!-- Navigable HTML report -->
      <html
        outputDirectory="coverage/html"
        lowUpperBound="50"
        highLowerBound="80"/>

      <!-- XML for CI/CD and badges -->
      <clover outputFile="coverage/clover.xml"/>

      <!-- Terminal summary -->
      <text
        outputFile="coverage/summary.txt"
        showUncoveredFiles="true"/>
    </report>
  </coverage>

  <php>
    <env name="SIMPLETEST_BASE_URL" value="http://voting-system.lndo.site"/>
    <env name="SIMPLETEST_DB" value="mysql://drupal11:drupal11@database/drupal11"/>
    <env name="BROWSERTEST_OUTPUT_DIRECTORY" value="/tmp"/>
    <env name="MINK_DRIVER_ARGS_WEBDRIVER" value='["chrome", {"browserName":"chrome","goog:chromeOptions":{"args":["--disable-gpu","--headless","--no-sandbox"]}},"http://localhost:9515"]'/>
  </php>

</phpunit>
