# Composer dependencies
/vendor/

# Drupal core and contrib — managed by Composer
/web/core
/web/modules/contrib
/web/themes/contrib
/web/profiles/contrib
/web/libraries

# Drupal scaffold files (regenerated on composer install)
/web/sites/default/settings.local.php
/web/sites/default/files/

# Environment — secrets never versioned, use .env.example as template
/.env

# Coverage reports — generated locally
/coverage/

# GrumPHP cache
.grumphp.yml.cache

# GitHub wiki (separate git repo)
/wiki/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
/.editorconfig
/.gitattributes