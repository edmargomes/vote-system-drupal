<?php

/**
 * @file
 * VS Core module.
 */

/**
 * Default value callback for the VotingQuestion uid field.
 *
 * Placed here rather than in the entity class because
 * setDefaultValueCallback() requires a static callable, and calling
 * \Drupal::currentUser() inside src/Entity/ would violate the project's
 * rule against static \Drupal::*() calls inside class files.
 *
 * @return array<int, array<string, int>>
 *   Default value array for entity_reference fields.
 */
function vs_core_voting_question_uid_default(): array {
  return [['target_id' => \Drupal::currentUser()->id()]];
}
