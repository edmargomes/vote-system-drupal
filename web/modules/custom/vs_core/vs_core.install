<?php

/**
 * @file
 * Install, update and uninstall functions for the VS Core module.
 */

/**
 * Implements hook_install().
 *
 * Adds the UNIQUE(uid, question_id) constraint to voting_vote after entity
 * tables are created. This constraint is the source of truth for vote
 * deduplication and cannot be expressed through entity annotations alone.
 *
 * Also sets the site front page to /vote so the question list is the default
 * landing page for visitors.
 */
function vs_core_install(): void {
  \Drupal::database()->schema()->addUniqueKey(
    'voting_vote',
    'uq_user_question',
    ['uid', 'question_id'],
  );

  \Drupal::configFactory()->getEditable('system.site')
    ->set('page.front', '/vote')
    ->save(TRUE);
}

/**
 * Implements hook_uninstall().
 *
 * Resets the front page to the Drupal default login page so the site
 * does not serve a 404 after the module is removed.
 */
function vs_core_uninstall(): void {
  \Drupal::configFactory()->getEditable('system.site')
    ->set('page.front', '/user/login')
    ->save(TRUE);
}

/**
 * Sets the site front page to /vote on already-installed sites.
 */
function vs_core_update_10001(): void {
  \Drupal::configFactory()->getEditable('system.site')
    ->set('page.front', '/vote')
    ->save(TRUE);
}

/**
 * Adds the closes_at column to voting_question for question expiry support.
 */
function vs_core_update_10002(): void {
  $spec = [
    'type' => 'int',
    'size' => 'normal',
    'unsigned' => TRUE,
    'not null' => FALSE,
    'default' => NULL,
    'description' => 'Unix timestamp when the question closes. NULL means no expiry.',
  ];
  \Drupal::database()->schema()->addField('voting_question', 'closes_at', $spec);
}
