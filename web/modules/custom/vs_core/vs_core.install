<?php

/**
 * @file
 * Install, update and uninstall functions for the VS Core module.
 */

/**
 * Implements hook_install().
 *
 * Adds the UNIQUE(uid, question_id) constraint to voting_vote after entity
 * tables are created. This constraint is the source of truth for vote
 * deduplication and cannot be expressed through entity annotations alone.
 */
function vs_core_install(): void {
  \Drupal::database()->schema()->addUniqueKey(
    'voting_vote',
    'uq_user_question',
    ['uid', 'question_id'],
  );
}
