# Copy this file to .env and fill in your values.
# Never commit .env — it contains secrets.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=database
DB_PORT=3306
DB_NAME=drupal11
DB_USER=drupal11
DB_PASSWORD=drupal11

# ---------------------------------------------------------------------------
# Drupal
# ---------------------------------------------------------------------------
# Generate with: drush php-eval 'echo \Drupal\Component\Utility\Crypt::randomBytesBase64(55) . PHP_EOL;'
DRUPAL_HASH_SALT=change-me-to-a-random-string

# Hostname(s) accepted by Drupal's trusted_host_patterns.
# Separate multiple hosts with commas: host1.com,host2.com
SITE_URL=voting-system.lndo.site
